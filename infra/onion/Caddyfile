# Onion mirror front door (README 3, A6 T1). Tor forwards the onion's port 80 here.
# Never add a `log` directive: no access logs, no IPs (README 13).
{
	admin off
	auto_https off
}

http://:8088 {
	bind 127.0.0.1

	# PDFs and metadata from our own Kubo node (pinned content only, see start.sh).
	handle /ipfs/* {
		reverse_proxy 127.0.0.1:8080 {
			header_up Host 127.0.0.1:8080
			header_up -X-Forwarded-For
		}
	}

	# Scanner upload API (A3), I5. The scanner accepts 30 MB PDFs; cap the whole multipart body.
	handle /api/* {
		request_body {
			max_size 32MB
		}
		reverse_proxy 127.0.0.1:8000 {
			header_up -X-Forwarded-For
		}
	}

	# Fuji RPC for readers who cannot reach a public RPC.
	handle /rpc {
		rewrite * /ext/bc/C/rpc
		reverse_proxy https://api.avax-test.network {
			header_up Host api.avax-test.network
			header_up -X-Forwarded-For
		}
	}

	# The reader build (apps/reader/dist), or the test page until it exists.
	handle {
		root * {$SITE_ROOT}
		file_server
	}
}

# Clearnet upload tunnel's way in (tunnel.sh): only the scanner API, with the same 32 MB body cap as the
# onion. Cloudflare puts the uploader's IP in CF-Connecting-IP; pass it on as X-Forwarded-For so the
# scanner's per-IP upload limit still works (it trusts X-Forwarded-For only from a loopback proxy).
http://:8089 {
	bind 127.0.0.1

	handle /api/* {
		request_body {
			max_size 32MB
		}
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Forwarded-For {header.CF-Connecting-IP}
		}
	}

	handle {
		respond 404
	}
}
