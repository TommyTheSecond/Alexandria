    "test": "vitest run"
  },
  "dependencies": {
    "@alexandria/sdk": "workspace:*",
    "preact": "^10.26.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.64.1",
    "typescript": "~5.7.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
