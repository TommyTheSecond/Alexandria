# Copy to scanner/.env (gitignored) or set these in the environment. Never commit values.

# 1 = reject uploads when ClamAV is missing. Set this on the onion host.
ALEXANDRIA_REQUIRE_CLAMAV=
# Where reports and the MinHash index live. Default: scanner/data (gitignored).
ALEXANDRIA_DATA_DIR=

# /api/submit stays off (503) until RELAY_SECRET is set. Same value as the relayer's RELAY_SECRET.
RELAY_SECRET=
# Default http://127.0.0.1:8787
RELAYER_URL=
# Default http://127.0.0.1:5001 (Kubo API; never expose it)
KUBO_API_URL=

# Registry lookup for dup.sha256. Defaults: Fuji public RPC and deployments/fuji.json.
RPC_URL=
DEPLOYMENT=

# Optional second copy on Filebase (S3 API, CAR import keeps Kubo's CID).
FILEBASE_BUCKET=
FILEBASE_ACCESS_KEY_ID=
FILEBASE_SECRET_ACCESS_KEY=

# Upload limits. Defaults: 5 per IP per hour, 200 per day in total (keep the daily total <= the relayer's RELAY_DAILY_CAP).
UPLOADS_PER_HOUR=
UPLOADS_PER_DAY=

# Temporary test-phase toggle: 1 = allow re-uploading PDFs already on-chain (default 1 during test phase; set 0 to disable).
ALLOW_REUPLOADS=

