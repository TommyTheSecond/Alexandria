{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alexandria/node-report.schema.json",
  "title": "Alexandria node epoch report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "epoch", "from", "to", "operators", "active", "checks"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "epoch": { "type": "integer", "minimum": 0 },
    "from": { "type": "string" },
    "to": { "type": "string" },
    "operators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["address", "gateway", "probes", "passed", "active", "duplicateOf"],
        "properties": {
          "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "gateway": { "type": "string" },
          "probes": { "type": "integer", "minimum": 0 },
          "passed": { "type": "integer", "minimum": 0 },
          "active": { "type": "boolean" },
          "duplicateOf": {
            "type": ["string", "null"],
            "pattern": "^0x[0-9a-fA-F]{40}$"
          }
        }
      }
    },
    "active": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{40}$"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operator", "cid", "ok", "ms", "error", "at"],
        "properties": {
          "operator": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "cid": { "type": "string" },
          "ok": { "type": "boolean" },
          "ms": { "type": "integer", "minimum": 0 },
          "error": { "type": ["string", "null"] },
          "at": { "type": "string" }
        }
      }
    }
  }
}
